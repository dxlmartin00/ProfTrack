rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // User profiles & FCM push tokens
    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }

    // Classes Collection (Scoped to Instructor)
    match /classes/{classId} {
      // Allow read if user is the instructor of the class
      allow read: if isAuthenticated() && (resource.data.instructorId == request.auth.uid);
      
      // Allow create if authenticated and setting self as instructor
      allow create: if isAuthenticated() 
        && request.resource.data.instructorId == request.auth.uid
        && request.resource.data.subjectCode is string
        && request.resource.data.subjectCode.size() >= 2;

      // Allow update/delete only if owned by this instructor
      allow update: if isAuthenticated() 
        && resource.data.instructorId == request.auth.uid
        && request.resource.data.instructorId == request.auth.uid;
        
      allow delete: if isAuthenticated() 
        && resource.data.instructorId == request.auth.uid;

      // Session Logs Subcollection (under class)
      match /session_logs/{logId} {
        allow read, create, update, delete: if isAuthenticated()
          && get(/databases/$(database)/documents/classes/$(classId)).data.instructorId == request.auth.uid;
      }
    }

    // Deny all other access by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // User accounts registry (Phone ⇄ Laptop multi-tenant synchronization)
    match /users/{userId} {
      allow read, write: if true;
    }

    // User sync snapshots (Classes, session logs, instructor profile)
    match /user_sync/{userId} {
      allow read, write: if true;
    }

    // Deletion tombstones (prevents resurrection of deleted users across devices)
    match /tombstones/{tombstoneId} {
      allow read, write: if true;
    }

    // Classes Collection & Session Logs
    match /classes/{classId} {
      allow read, write: if true;
      match /session_logs/{logId} {
        allow read, write: if true;
      }
    }
  }
}
